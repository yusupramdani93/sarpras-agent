{
  "manifest_version": 3,
  "name": "Sarpras Dapo Sync (DEV)",
  "short_name": "Sarpras Sync DEV",
  "version": "1.0.0",
  "description": "DEV build: sync ke mock API localhost:8787.",
  "default_locale": "id",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "http://localhost:5774/*",
    "http://localhost:8787/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Sarpras Dapo Sync (DEV)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:5774/*"],
      "js": ["src/transform.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}